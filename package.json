{
  "name": "verzel-qa-junior",
  "version": "1.0.0",
  "private": true,
  "description": "Testes QA da Verzel Store com Playwright e TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:infra": "playwright test tests/infrastructure.spec.ts",
    "test:headed": "playwright test --headed",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "test:list": "playwright test --list",
    "report": "playwright show-report",
    "report:demo": "playwright show-report playwright-demo-report",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "20.19.43",
    "typescript": "7.0.2"
  }
}
